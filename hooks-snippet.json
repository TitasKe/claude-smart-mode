{
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash -c '{ [ -f \"/tmp/claude-smart-${CLAUDE_SESSION_ID:-default}\" ] && { [ -f ~/.claude/smart-config.md ] && cat ~/.claude/smart-config.md; cat ~/.claude/smart-inject.md; }; } || true'"
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash -c 'rm -f \"/tmp/claude-smart-${CLAUDE_SESSION_ID:-default}\"'"
        }
      ]
    }
  ]
}
